# ════════════════════════════════════════════════════════════════
# CyberMind IDS — Environment Variables
# ════════════════════════════════════════════════════════════════
# Copy this file:  cp .env.example .env
# Fill in real values — NEVER commit .env to git
# ════════════════════════════════════════════════════════════════

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_PORT=5000
FLASK_DEBUG=1

# AI / LLM API keys (optional — IDS works offline without them)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Packet scanner
SCAN_PACKET_COUNT=100
SCAN_TIMEOUT_SECONDS=30
