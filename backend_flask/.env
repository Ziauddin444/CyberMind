# ════════════════════════════════════════════════════════════════════════════
# CyberMind Sentinel — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file to .env  (cp .env.example .env)
#   2. Fill in your real keys — NEVER commit .env to git
#   3. Flask auto-loads this file via python-dotenv
# ════════════════════════════════════════════════════════════════════════════

# ── Flask runtime ─────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-long-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AI / LLM API Keys (keep secret — never hardcode in Python files) ─────────
# Leave blank to use the built-in offline IDS engine (no API calls needed)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ── Packet scan settings ─────────────────────────────────────────────────────
# Maximum packets per scan (clamped server-side to 10–500)
SCAN_PACKET_COUNT=100
# Scapy capture timeout in seconds
SCAN_TIMEOUT_SECONDS=30

# ── Email alerts (optional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
FLASK_ENV=development
