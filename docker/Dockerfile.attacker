FROM debian:bookworm-slim

# Lightweight "attacker" toolkit — same tools Kali demo uses, without a full Kali image
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    hydra \
    hping3 \
    netcat-openbsd \
    curl \
    jq \
    iputils-ping \
    net-tools \
    iproute2 \
    ca-certificates \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /attacks

COPY docker/sandbox/run_attacks.sh /attacks/run_attacks.sh
COPY docker/sandbox/collect_results.sh /attacks/collect_results.sh
RUN chmod +x /attacks/*.sh

# Keep container alive for interactive + scripted attacks
CMD ["sleep", "infinity"]
